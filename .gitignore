songs/*/out/
songs/*/stems/
songs/*/history/
songs/*/build/
songs/*/requests/
songs/*/last_song.json
songs/*/mix.json
build/
tmp/

# Audio anywhere (Tests/check_conventions.py also rejects tracked audio)
*.wav
*.mp3
*.ogg
*.flac
*.aif
*.aiff
